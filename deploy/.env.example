# The published image. Pin a version, or use latest for the newest mainline build.
OPENPENCIL_IMAGE=ghcr.io/miloszkolber/openpencil:latest

# Use URL-safe characters. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-url-safe-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# SeaweedFS development credentials. They must match seaweedfs/s3.json.
S3_ACCESS_KEY_ID=openpencil
S3_SECRET_ACCESS_KEY=openpencil-development-secret

TZ=UTC
